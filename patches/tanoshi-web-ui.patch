diff --git a/crates/tanoshi-web/src/common/layout_preference.rs b/crates/tanoshi-web/src/common/layout_preference.rs
new file mode 100644
index 0000000..36f8b10
--- /dev/null
+++ b/crates/tanoshi-web/src/common/layout_preference.rs
@@ -0,0 +1,322 @@
+use std::rc::Rc;
+
+use dominator::{clone, events, html, with_node, Dom};
+use futures_signals::signal::{Mutable, SignalExt};
+use futures_signals::signal_vec::{MutableVec, SignalVecExt};
+use serde::{Deserialize, Serialize};
+use web_sys::HtmlInputElement;
+
+use crate::common::reader_settings::{
+    Background, Direction, DisplayMode, Fit, ReaderMode, ReaderSettings, KEY as READER_KEY,
+};
+use crate::common::snackbar;
+use crate::utils::local_storage;
+
+const PRESETS_KEY: &str = "settings:layout_presets";
+const SELECTED_KEY: &str = "settings:layout_selected";
+
+pub const DEFAULT_PRESET_NAME: &str = "default";
+
+/// A named snapshot of the reader options. Presets and the current selection
+/// live in `localStorage`, so they follow the device, not the server account:
+/// a device that has never picked a preset starts from the Default preset.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct LayoutPreset {
+    pub name: String,
+    pub reader_mode: ReaderMode,
+    pub padding: bool,
+    pub display_mode: DisplayMode,
+    pub direction: Direction,
+    pub background: Background,
+    pub fit: Fit,
+}
+
+impl LayoutPreset {
+    pub fn default_preset() -> Self {
+        Self {
+            name: DEFAULT_PRESET_NAME.to_string(),
+            reader_mode: ReaderMode::Paged,
+            padding: false,
+            display_mode: DisplayMode::Single,
+            direction: Direction::LeftToRight,
+            background: Background::White,
+            fit: Fit::All,
+        }
+    }
+
+    fn summary(&self) -> String {
+        let reader_mode = match self.reader_mode {
+            ReaderMode::Paged => "Paged",
+            ReaderMode::Continous => "Continuous",
+        };
+        let padding = if self.padding { "Padding" } else { "No Padding" };
+        let display_mode = match self.display_mode {
+            DisplayMode::Single => "Single",
+            DisplayMode::Double => "Double",
+            DisplayMode::Auto => "Auto",
+        };
+        let direction = match self.direction {
+            Direction::LeftToRight => "Left to Right",
+            Direction::RightToLeft => "Right to Left",
+        };
+        let background = match self.background {
+            Background::White => "White",
+            Background::Black => "Black",
+        };
+        let fit = match self.fit {
+            Fit::All => "Fit All",
+            Fit::Height => "Fit Height",
+            Fit::Width => "Fit Width",
+        };
+
+        format!(
+            "{reader_mode} • {display_mode} • {direction} • {background} • {fit} • {padding}"
+        )
+    }
+}
+
+pub struct LayoutPreference {
+    presets: Rc<MutableVec<LayoutPreset>>,
+    selected: Mutable<String>,
+    adding: Mutable<bool>,
+    new_name: Mutable<String>,
+}
+
+impl LayoutPreference {
+    pub fn new() -> Rc<Self> {
+        let presets = Self::load_presets();
+        let selected = Self::load_selected(&presets);
+
+        Rc::new(Self {
+            presets: Rc::new(MutableVec::new_with_values(presets)),
+            selected: Mutable::new(selected),
+            adding: Mutable::new(false),
+            new_name: Mutable::new(String::new()),
+        })
+    }
+
+    fn load_presets() -> Vec<LayoutPreset> {
+        let mut presets = vec![LayoutPreset::default_preset()];
+
+        if let Ok(Some(raw)) = local_storage().get_item(PRESETS_KEY) {
+            if let Ok(saved) = serde_json::from_str::<Vec<LayoutPreset>>(&raw) {
+                for preset in saved {
+                    if preset.name != DEFAULT_PRESET_NAME
+                        && !presets.iter().any(|item| item.name == preset.name)
+                    {
+                        presets.push(preset);
+                    }
+                }
+            }
+        }
+
+        presets
+    }
+
+    fn load_selected(presets: &[LayoutPreset]) -> String {
+        local_storage()
+            .get_item(SELECTED_KEY)
+            .ok()
+            .flatten()
+            .filter(|name| presets.iter().any(|preset| &preset.name == name))
+            .unwrap_or_else(|| DEFAULT_PRESET_NAME.to_string())
+    }
+
+    fn persist_presets(presets: &[LayoutPreset]) {
+        let custom: Vec<&LayoutPreset> = presets
+            .iter()
+            .filter(|preset| preset.name != DEFAULT_PRESET_NAME)
+            .collect();
+
+        if let Ok(raw) = serde_json::to_string(&custom) {
+            let _ = local_storage().set_item(PRESETS_KEY, &raw);
+        }
+    }
+
+    /// Per-manga reader settings would shadow the preset, so drop them when a
+    /// preset is chosen; the reader then falls back to the global settings.
+    fn clear_manga_overrides() {
+        let storage = local_storage();
+        let prefix = format!("{READER_KEY}:");
+        let mut keys = Vec::new();
+
+        for index in 0..storage.length().unwrap_or(0) {
+            if let Ok(Some(key)) = storage.key(index) {
+                if key.starts_with(&prefix) {
+                    keys.push(key);
+                }
+            }
+        }
+
+        for key in keys {
+            let _ = storage.delete(&key);
+        }
+    }
+
+    fn select(self: &Rc<Self>, preset: LayoutPreset) {
+        let settings = ReaderSettings::new(false, false);
+        settings.apply_preset(&preset);
+        settings.save();
+        Self::clear_manga_overrides();
+
+        self.selected.set(preset.name.clone());
+        let _ = local_storage().set_item(SELECTED_KEY, &preset.name);
+        snackbar::show(format!("Layout preset \"{}\" applied", preset.name));
+    }
+
+    fn add(self: &Rc<Self>) {
+        let name = self.new_name.get_cloned().trim().to_string();
+        if name.is_empty() {
+            snackbar::show("Enter a preset name first".to_string());
+            return;
+        }
+        if self
+            .presets
+            .lock_ref()
+            .iter()
+            .any(|preset| preset.name.eq_ignore_ascii_case(&name))
+        {
+            snackbar::show("A preset with that name already exists".to_string());
+            return;
+        }
+
+        // Snapshot the reader options currently in effect on this device.
+        let settings = ReaderSettings::new(false, false);
+        let preset = LayoutPreset {
+            name,
+            reader_mode: settings.reader_mode.get(),
+            padding: settings.padding.get(),
+            display_mode: settings.display_mode.get(),
+            direction: settings.direction.get(),
+            background: settings.background.get(),
+            fit: settings.fit.get(),
+        };
+
+        self.presets.lock_mut().push_cloned(preset.clone());
+        Self::persist_presets(&self.presets.lock_ref());
+
+        self.new_name.set(String::new());
+        self.adding.set(false);
+        self.select(preset);
+    }
+
+    pub fn render(self: Rc<Self>) -> Dom {
+        let this = self;
+
+        html!("div", {
+            .class("content")
+            .style("padding", "0.5rem")
+            .children(&mut [
+                html!("p", {
+                    .style("margin", "0.5rem 0")
+                    .style("opacity", "0.8")
+                    .text("Presets bundle the reader options below. They are stored on this device only, so a new device starts from the Default preset.")
+                }),
+                html!("ul", {
+                    .class(["list", "group"])
+                    .style("margin-bottom", "0.5rem")
+                    .children_signal_vec(this.presets.signal_vec_cloned().map(clone!(this => move |preset| {
+                        let name = preset.name.clone();
+                        html!("li", {
+                            .class("list-item")
+                            .style("display", "flex")
+                            .style("align-items", "center")
+                            .style("justify-content", "space-between")
+                            .children(&mut [
+                                html!("div", {
+                                    .style("display", "flex")
+                                    .style("flex-direction", "column")
+                                    .style("min-width", "0")
+                                    .children(&mut [
+                                        html!("span", {
+                                            .text(&name)
+                                        }),
+                                        html!("span", {
+                                            .style("font-size", "0.75rem")
+                                            .style("opacity", "0.7")
+                                            .text(&preset.summary())
+                                        }),
+                                    ])
+                                }),
+                                html!("div", {
+                                    .style("display", "flex")
+                                    .style("align-items", "center")
+                                    .style("margin-left", "0.5rem")
+                                    .child_signal(this.selected.signal_cloned().map(clone!(this, preset => move |selected| {
+                                        if selected == preset.name {
+                                            Some(html!("span", {
+                                                .style("color", "var(--primary-color)")
+                                                .style("font-weight", "bold")
+                                                .text("Selected")
+                                            }))
+                                        } else {
+                                            Some(html!("button", {
+                                                .text("Use")
+                                                .event(clone!(this, preset => move |_: events::Click| {
+                                                    this.select(preset.clone());
+                                                }))
+                                            }))
+                                        }
+                                    })))
+                                }),
+                            ])
+                        })
+                    })))
+                }),
+                html!("div", {
+                    .child_signal(this.adding.signal().map(clone!(this => move |adding| {
+                        if adding {
+                            Some(html!("div", {
+                                .style("display", "flex")
+                                .style("align-items", "center")
+                                .style("flex-wrap", "wrap")
+                                .style("gap", "0.5rem")
+                                .children(&mut [
+                                    html!("input" => HtmlInputElement, {
+                                        .style("flex", "1")
+                                        .style("min-width", "8rem")
+                                        .attr("type", "text")
+                                        .attr("placeholder", "Preset name")
+                                        .attr_signal("value", this.new_name.signal_cloned())
+                                        .with_node!(input => {
+                                            .event(clone!(this => move |_: events::Input| {
+                                                this.new_name.set(input.value());
+                                            }))
+                                            .event_with_options(&dominator::EventOptions::preventable(), clone!(this => move |e: events::KeyDown| {
+                                                if e.key() == "Enter" {
+                                                    e.prevent_default();
+                                                    this.add();
+                                                }
+                                            }))
+                                        })
+                                    }),
+                                    html!("button", {
+                                        .text("Create")
+                                        .event(clone!(this => move |_: events::Click| {
+                                            this.add();
+                                        }))
+                                    }),
+                                    html!("button", {
+                                        .text("Cancel")
+                                        .event(clone!(this => move |_: events::Click| {
+                                            this.adding.set(false);
+                                            this.new_name.set(String::new());
+                                        }))
+                                    }),
+                                ])
+                            }))
+                        } else {
+                            Some(html!("button", {
+                                .style("margin-top", "0.5rem")
+                                .text("Add New Preset")
+                                .event(clone!(this => move |_: events::Click| {
+                                    this.adding.set(true);
+                                }))
+                            }))
+                        }
+                    })))
+                }),
+            ])
+        })
+    }
+}
