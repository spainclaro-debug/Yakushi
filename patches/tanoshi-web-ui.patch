+    async fn delete_all_history(&self, user_id: i64) -> Result<u64, HistoryRepositoryError> {
+        let mut tx = self.pool.write().begin().await?;
+
+        // Deleting the per-manga summary first keeps the row-level triggers on
+        // `user_history` from rewriting it while the detail rows go away.
+        sqlx::query("DELETE FROM user_manga_history WHERE user_id = ?")
+            .bind(user_id)
+            .execute(&mut *tx)
+            .await?;
+
+        let result = sqlx::query("DELETE FROM user_history WHERE user_id = ?")
+            .bind(user_id)
+            .execute(&mut *tx)
+            .await?;
+
+        tx.commit().await?;
+
+        Ok(result.rows_affected())
+    }
