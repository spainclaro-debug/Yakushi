+    async fn import_history_chapter(
+        &self,
+        user_id: i64,
+        chapter_id: i64,
+        page: i64,
+        is_complete: bool,
+        read_at: chrono::NaiveDateTime,
+    ) -> Result<(), HistoryRepositoryError> {
+        let mut tx = self.pool.write().begin().await?;
+
+        // `manga_id` is denormalized by the insert trigger when omitted, but the
+        // explicit value keeps this working with the trigger's normalization.
+        sqlx::query(
+            r#"
+            INSERT INTO user_history(user_id, chapter_id, manga_id, last_page, read_at, is_complete)
+            VALUES (?, ?, (SELECT manga_id FROM chapter WHERE id = ?), ?, ?, ?)
+            ON CONFLICT(user_id, chapter_id)
+            DO UPDATE SET
+                last_page = excluded.last_page,
+                read_at = excluded.read_at,
+                is_complete = excluded.is_complete"#,
+        )
+        .bind(user_id)
+        .bind(chapter_id)
+        .bind(chapter_id)
+        .bind(page)
+        .bind(read_at)
+        .bind(is_complete)
+        .execute(&mut *tx)
+        .await?;
+
+        // Keep the per-manga summary used by the History page in sync. Only a
+        // newer read replaces the summary row.
+        sqlx::query(
+            r#"
+            INSERT INTO user_manga_history(user_id, manga_id, chapter_id, read_at)
+            SELECT ?, c.manga_id, c.id, ?
+            FROM chapter c
+            WHERE c.id = ?
+            ON CONFLICT(user_id, manga_id)
+            DO UPDATE SET
+                chapter_id = excluded.chapter_id,
+                read_at = excluded.read_at
+            WHERE user_manga_history.read_at < excluded.read_at"#,
+        )
+        .bind(user_id)
+        .bind(read_at)
+        .bind(chapter_id)
+        .execute(&mut *tx)
+        .await?;
+
+        tx.commit().await?;
+
+        Ok(())
+    }
