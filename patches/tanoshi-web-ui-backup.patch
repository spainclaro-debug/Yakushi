diff --git a/crates/tanoshi-web/src/settings_backup.rs b/crates/tanoshi-web/src/settings_backup.rs
new file mode 100644
index 0000000..a5739f7
--- /dev/null
+++ b/crates/tanoshi-web/src/settings_backup.rs
@@ -0,0 +1,492 @@
+use std::rc::Rc;
+
+use dominator::{clone, events, html, with_node, Dom};
+use futures_signals::signal::{Mutable, SignalExt};
+use futures_signals::signal_vec::{MutableVec, SignalVecExt};
+use gloo_timers::future::TimeoutFuture;
+use wasm_bindgen::prelude::*;
+use wasm_bindgen::JsCast;
+use wasm_bindgen_futures::spawn_local;
+use web_sys::{Blob, BlobPropertyBag, FileReader, HtmlAnchorElement, HtmlInputElement};
+
+use crate::common::{snackbar, Spinner};
+use crate::query;
+use crate::utils::{document, window};
+
+#[derive(Clone, Debug)]
+pub struct MissingSource {
+    pub id: i64,
+    pub name: String,
+    pub version: String,
+}
+
+pub struct SettingsBackup {
+    busy: Mutable<bool>,
+    status: Mutable<String>,
+    errors: MutableVec<String>,
+    missing: MutableVec<MissingSource>,
+    pending_restore: Mutable<Option<String>>,
+}
+
+impl SettingsBackup {
+    pub fn new() -> Rc<Self> {
+        Rc::new(Self {
+            busy: Mutable::new(false),
+            status: Mutable::new(String::new()),
+            errors: MutableVec::new(),
+            missing: MutableVec::new(),
+            pending_restore: Mutable::new(None),
+        })
+    }
+
+    // -----------------------------------------------------------------------
+    // Backup
+    // -----------------------------------------------------------------------
+
+    pub fn backup(this: Rc<Self>) {
+        if this.busy.get() {
+            return;
+        }
+        this.busy.set(true);
+        this.status.set("Preparing your backup…".to_string());
+        this.errors.lock_mut().clear();
+        this.missing.lock_mut().clear();
+
+        spawn_local(async move {
+            match query::export_backup().await {
+                Ok(json) => {
+                    let date = js_sys::Date::new_0()
+                        .to_iso_string()
+                        .as_string()
+                        .unwrap_or_default();
+                    let file_name = format!(
+                        "tanoshi-backup-{}.json",
+                        date.chars().take(10).collect::<String>()
+                    );
+                    match Self::save_file(&file_name, &json) {
+                        Ok(message) => this.status.set(message),
+                        Err(message) => {
+                            this.status.set(message.clone());
+                            snackbar::show(message);
+                        }
+                    }
+                }
+                Err(error) => {
+                    let message = format!("Could not create the backup: {error}");
+                    this.status.set(message.clone());
+                    snackbar::show(message);
+                }
+            }
+            this.busy.set(false);
+        });
+    }
+
+    fn save_file(file_name: &str, json: &str) -> Result<String, String> {
+        if let Some(bridge) = android_bridge() {
+            let args = js_sys::Array::new();
+            args.push(&JsValue::from_str(file_name));
+            args.push(&JsValue::from_str(json));
+            let result = call_bridge(&bridge, "saveBackup", &args)
+                .and_then(|value| value.as_string())
+                .ok_or_else(|| "The app could not save the backup file".to_string())?;
+
+            if let Some(path) = result.strip_prefix("OK|") {
+                return Ok(format!("Backup saved to {path}"));
+            }
+            if let Some(error) = result.strip_prefix("ERROR|") {
+                return Err(format!("Could not save the backup: {error}"));
+            }
+            return Ok(result);
+        }
+
+        save_in_browser(file_name, json).map_err(|error| format!("Could not save the backup: {error}"))?;
+        Ok(format!("Backup downloaded as {file_name}"))
+    }
+
+    // -----------------------------------------------------------------------
+    // Restore
+    // -----------------------------------------------------------------------
+
+    fn pick_file() {
+        if let Some(element) = document().get_element_by_id("backup-file-input") {
+            if let Ok(input) = element.dyn_into::<HtmlInputElement>() {
+                let _ = input.click();
+            }
+        }
+    }
+
+    fn read_file(this: Rc<Self>, file: web_sys::File) {
+        let reader = FileReader::new().unwrap_throw();
+        let reader_ref = reader.clone();
+        let onload = clone!(this => move |_: web_sys::Event| {
+            if let Ok(result) = reader_ref.result() {
+                if let Some(text) = result.as_string() {
+                    Self::restore(this.clone(), text);
+                }
+            }
+        });
+        let callback = Closure::wrap(Box::new(onload) as Box<dyn FnMut(_)>);
+        reader.set_onload(Some(callback.as_ref().unchecked_ref()));
+        callback.forget();
+        let _ = reader.read_as_text(&file);
+    }
+
+    fn restore(this: Rc<Self>, text: String) {
+        if this.busy.get() {
+            return;
+        }
+
+        // Reject obviously wrong files before calling the server.
+        match serde_json::from_str::<serde_json::Value>(&text) {
+            Ok(value) => {
+                let format = value.get("format").and_then(|value| value.as_str()).unwrap_or("");
+                if format != "tanoshi-backup" {
+                    let message = "That file is not a Tanoshi backup. Pick a file created by \"Save Backup\".".to_string();
+                    this.status.set(message.clone());
+                    snackbar::show(message);
+                    return;
+                }
+            }
+            Err(error) => {
+                let message = format!("That file is not valid JSON: {error}");
+                this.status.set(message.clone());
+                snackbar::show(message);
+                return;
+            }
+        }
+
+        this.pending_restore.set(Some(text));
+        Self::run_restore(this);
+    }
+
+    fn run_restore(this: Rc<Self>) {
+        let Some(text) = this.pending_restore.get_cloned() else {
+            return;
+        };
+
+        this.busy.set(true);
+        this.status.set("Restoring your library…".to_string());
+        this.errors.lock_mut().clear();
+        this.missing.lock_mut().clear();
+
+        spawn_local(async move {
+            match query::restore_backup(&text).await {
+                Ok(result) => {
+                    let missing: Vec<MissingSource> = result
+                        .missing_sources
+                        .iter()
+                        .map(|source| MissingSource {
+                            id: source.id,
+                            name: source.name.clone(),
+                            version: source.version.clone(),
+                        })
+                        .collect();
+                    let missing_count = missing.len();
+                    this.missing.lock_mut().replace_cloned(missing);
+
+                    let mut summary = format!(
+                        "Restored {} title(s) and {} history entry(ies); {} skipped.",
+                        result.imported, result.history_restored, result.skipped
+                    );
+                    if missing_count > 0 {
+                        summary.push_str(" Some sources are missing: install them below and restore again.");
+                    }
+                    this.status.set(summary.clone());
+                    snackbar::show(summary);
+                    this.errors
+                        .lock_mut()
+                        .replace_cloned(result.errors.into_iter().collect());
+                }
+                Err(error) => {
+                    let message = format!("Restore failed: {error}");
+                    this.status.set(message.clone());
+                    snackbar::show(message);
+                }
+            }
+            this.busy.set(false);
+        });
+    }
+
+    // -----------------------------------------------------------------------
+    // Missing sources
+    // -----------------------------------------------------------------------
+
+    fn install_missing(this: Rc<Self>) {
+        if this.busy.get() || this.missing.lock_ref().is_empty() {
+            return;
+        }
+        let missing: Vec<MissingSource> = this.missing.lock_ref().to_vec();
+        this.busy.set(true);
+        this.status.set("Installing the missing sources…".to_string());
+
+        if let Some(bridge) = android_bridge() {
+            let payload = serde_json::to_string(
+                &missing
+                    .iter()
+                    .map(|source| {
+                        serde_json::json!({ "id": source.id, "name": source.name })
+                    })
+                    .collect::<Vec<_>>(),
+            )
+            .unwrap_or_default();
+            let args = js_sys::Array::new();
+            args.push(&JsValue::from_str(&payload));
+            if call_bridge(&bridge, "installExtensions", &args).is_none() {
+                this.busy.set(false);
+                this.status
+                    .set("The app could not start the extension installer.".to_string());
+                return;
+            }
+            Self::wait_for_sources(this);
+            return;
+        }
+
+        // Server-side installation (Termux / desktop server).
+        spawn_local(async move {
+            for source in &missing {
+                if let Err(error) = query::install_source(source.id).await {
+                    snackbar::show(format!("Could not install {}: {error}", source.name));
+                }
+            }
+            Self::wait_for_sources(this);
+        });
+    }
+
+    /// Polls the installed sources until the missing ones show up (the app
+    /// restarts the server after installing extensions), then restores again.
+    fn wait_for_sources(this: Rc<Self>) {
+        spawn_local(async move {
+            for _ in 0..25 {
+                TimeoutFuture::new(1500).await;
+                if let Ok(sources) = query::fetch_sources().await {
+                    let installed: std::collections::HashSet<i64> =
+                        sources.iter().map(|source| source.id).collect();
+                    if this
+                        .missing
+                        .lock_ref()
+                        .iter()
+                        .all(|missing| installed.contains(&missing.id))
+                    {
+                        this.missing.lock_mut().clear();
+                        this.busy.set(false);
+                        this.status.set("Sources installed. Restoring again…".to_string());
+                        Self::run_restore(this);
+                        return;
+                    }
+                }
+            }
+
+            this.busy.set(false);
+            this.status.set(
+                "The sources have not appeared yet. If the app restarted the server, wait a moment and tap \"Choose Backup File\" again."
+                    .to_string(),
+            );
+        });
+    }
+
+    // -----------------------------------------------------------------------
+    // Rendering
+    // -----------------------------------------------------------------------
+
+    fn render_card<F>(title: &str, description: &str, action: Dom, extra: F) -> Dom
+    where
+        F: FnOnce() -> Dom,
+    {
+        html!("div", {
+            .style("border-radius", "0.75rem")
+            .style("padding", "0.75rem")
+            .style("margin-bottom", "0.75rem")
+            .style("background", "var(--list-group-background-color, rgba(255,255,255,0.06))")
+            .style("border", "1px solid rgba(127,127,127,0.25)")
+            .children(&mut [
+                html!("h3", {
+                    .style("margin", "0 0 0.25rem 0")
+                    .text(title)
+                }),
+                html!("p", {
+                    .style("margin", "0 0 0.75rem 0")
+                    .style("opacity", "0.8")
+                    .style("font-size", "0.875rem")
+                    .text(description)
+                }),
+                action,
+                extra(),
+            ])
+        })
+    }
+
+    pub fn render(self: Rc<Self>) -> Dom {
+        let this = self;
+
+        html!("div", {
+            .class("content")
+            .style("padding", "0.5rem")
+            .children(&mut [
+                Self::render_card(
+                    "Backup Library",
+                    "Saves your library titles, reading history, the sources they use and the chapter you are currently reading as a .json file in your phone's Downloads folder.",
+                    html!("button", {
+                        .style("display", "block")
+                        .style("width", "100%")
+                        .style("border-radius", "0.5rem")
+                        .style("padding", "0.5rem")
+                        .style("background", "var(--primary-color, #5b749b)")
+                        .style("color", "#fff")
+                        .text("Save Backup")
+                        .event(clone!(this => move |_: events::Click| Self::backup(this.clone())))
+                    }),
+                    || html!("div", {}),
+                ),
+                Self::render_card(
+                    "Restore Library",
+                    "Pick a backup file to restore your library and reading progress. Missing sources are reported so you can install them.",
+                    html!("label", {
+                        .style("display", "block")
+                        .style("width", "100%")
+                        .style("text-align", "center")
+                        .style("border-radius", "0.5rem")
+                        .style("padding", "0.5rem")
+                        .style("background", "var(--primary-color, #5b749b)")
+                        .style("color", "#fff")
+                        .style("cursor", "pointer")
+                        .text("Choose Backup File")
+                        .children(&mut [
+                            html!("input" => HtmlInputElement, {
+                                .attr("id", "backup-file-input")
+                                .attr("type", "file")
+                                .attr("accept", "application/json,.json")
+                                .style("display", "none")
+                                .with_node!(input => {
+                                    .event(clone!(this, input => move |_: events::Change| {
+                                        if let Some(files) = input.files() {
+                                            if let Some(file) = files.get(0) {
+                                                Self::read_file(this.clone(), file);
+                                            }
+                                        }
+                                        input.set_value("");
+                                    }))
+                                })
+                            }),
+                        ])
+                    }),
+                    || html!("div", {}),
+                ),
+                html!("div", {
+                    .style("min-height", "1.25rem")
+                    .style("margin-top", "0.25rem")
+                    .style("opacity", "0.95")
+                    .text_signal(this.status.signal_cloned())
+                }),
+                html!("div", {
+                    .style("display", "flex")
+                    .style("justify-content", "center")
+                    .visible_signal(this.busy.signal())
+                    .child(Spinner::render(Spinner::new()))
+                }),
+                html!("div", {
+                    .child_signal(this.missing.signal_vec_cloned().len().map(clone!(this => move |len| {
+                        if len == 0 {
+                            return None;
+                        }
+                        Some(html!("div", {
+                            .style("margin-top", "0.5rem")
+                            .style("padding", "0.75rem")
+                            .style("border-radius", "0.75rem")
+                            .style("border", "1px solid rgba(255,170,0,0.6)")
+                            .style("background", "rgba(255,170,0,0.12)")
+                            .children(&mut [
+                                html!("h3", {
+                                    .style("margin", "0 0 0.25rem 0")
+                                    .text("Missing sources")
+                                }),
+                                html!("p", {
+                                    .style("margin", "0 0 0.5rem 0")
+                                    .style("font-size", "0.875rem")
+                                    .text("These sources are used by the backup but are not installed. Install them, then restore again.")
+                                }),
+                                html!("ul", {
+                                    .style("margin", "0 0 0.5rem 0")
+                                    .children_signal_vec(this.missing.signal_vec_cloned().map(|source| html!("li", {
+                                        .text(format!("{} (v{})", source.name, source.version).as_str())
+                                    })))
+                                }),
+                                html!("button", {
+                                    .style("width", "100%")
+                                    .text("Install Missing Sources")
+                                    .event(clone!(this => move |_: events::Click| Self::install_missing(this.clone())))
+                                }),
+                            ])
+                        }))
+                    })))
+                }),
+                html!("div", {
+                    .child_signal(this.errors.signal_vec_cloned().len().map(clone!(this => move |len| {
+                        (len > 0).then(|| html!("div", {
+                            .style("margin-top", "0.5rem")
+                            .style("padding", "0.75rem")
+                            .style("border-radius", "0.75rem")
+                            .style("background", "rgba(200,40,40,0.12)")
+                            .style("border", "1px solid rgba(200,40,40,0.45)")
+                            .children(&mut [
+                                html!("h3", {
+                                    .style("margin", "0 0 0.25rem 0")
+                                    .text("Warnings")
+                                }),
+                                html!("ul", {
+                                    .style("font-size", "0.8rem")
+                                    .style("margin", "0")
+                                    .children_signal_vec(this.errors.signal_vec_cloned().map(|error| html!("li", {
+                                        .text(&error)
+                                    })))
+                                }),
+                            ])
+                        }))
+                    })))
+                }),
+            ])
+        })
+    }
+}
+
+fn android_bridge() -> Option<JsValue> {
+    js_sys::Reflect::get(window().as_ref(), &JsValue::from_str("TanoshiApp"))
+        .ok()
+        .filter(|value| !value.is_undefined() && !value.is_null())
+}
+
+fn call_bridge(bridge: &JsValue, method: &str, args: &js_sys::Array) -> Option<JsValue> {
+    let function = js_sys::Reflect::get(bridge, &JsValue::from_str(method))
+        .ok()?
+        .dyn_into::<js_sys::Function>()
+        .ok()?;
+    function.apply(bridge, args).ok()
+}
+
+fn save_in_browser(file_name: &str, json: &str) -> Result<(), String> {
+    let parts = js_sys::Array::new();
+    parts.push(&JsValue::from_str(json));
+    let options = BlobPropertyBag::new();
+    options.set_type("application/json");
+    let blob = Blob::new_with_str_sequence_and_options(parts.as_ref(), &options)
+        .map_err(|error| format!("{error:?}"))?;
+    let url = web_sys::Url::create_object_url_with_blob(&blob)
+        .map_err(|error| format!("{error:?}"))?;
+
+    let anchor = document()
+        .create_element("a")
+        .map_err(|error| format!("{error:?}"))?
+        .dyn_into::<HtmlAnchorElement>()
+        .map_err(|_| "could not create the download link".to_string())?;
+    anchor
+        .set_attribute("href", &url)
+        .map_err(|error| format!("{error:?}"))?;
+    anchor.set_download(file_name);
+    let body = document().body().ok_or_else(|| "no document body".to_string())?;
+    body.append_child(&anchor)
+        .map_err(|error| format!("{error:?}"))?;
+    anchor.click();
+    let _ = body.remove_child(&anchor);
+    let _ = web_sys::Url::revoke_object_url(&url);
+
+    Ok(())
+}
