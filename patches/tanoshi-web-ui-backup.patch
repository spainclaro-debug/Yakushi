diff --git a/crates/tanoshi/src/presentation/graphql/backup.rs b/crates/tanoshi/src/presentation/graphql/backup.rs
new file mode 100644
index 0000000..308b5b1
--- /dev/null
+++ b/crates/tanoshi/src/presentation/graphql/backup.rs
@@ -0,0 +1,623 @@
+use async_graphql::{Context, Object, Result, SimpleObject};
+use chrono::{NaiveDateTime, Utc};
+use log::warn;
+use serde::{Deserialize, Serialize};
+use std::collections::{BTreeMap, BTreeSet, HashMap, HashSet};
+
+use crate::domain::{
+    entities::history::HistoryBounds,
+    services::{
+        chapter::ChapterService, history::HistoryService, library::LibraryService,
+        manga::MangaService, source::SourceService,
+    },
+};
+use crate::infrastructure::{
+    auth::Claims,
+    config::Config,
+    domain::repositories::{
+        chapter::ChapterRepositoryImpl, history::HistoryRepositoryImpl,
+        library::LibraryRepositoryImpl, manga::MangaRepositoryImpl, source::SourceRepositoryImpl,
+    },
+};
+
+/// File format written by [`BackupRoot::export_backup`]. Bump
+/// [`BACKUP_VERSION`] when the on-disk schema changes incompatibly.
+pub const BACKUP_FORMAT: &str = "tanoshi-backup";
+pub const BACKUP_VERSION: i64 = 1;
+
+#[derive(Debug, Serialize, Deserialize)]
+struct BackupDocument {
+    format: String,
+    version: i64,
+    #[serde(rename = "exportedAt", default)]
+    exported_at: String,
+    #[serde(rename = "serverVersion", default)]
+    server_version: String,
+    #[serde(default)]
+    sources: Vec<BackupSource>,
+    #[serde(default)]
+    library: Vec<BackupLibraryManga>,
+    #[serde(default)]
+    history: Vec<BackupHistoryEntry>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+struct BackupSource {
+    id: i64,
+    #[serde(default)]
+    name: String,
+    #[serde(default)]
+    version: String,
+    #[serde(default)]
+    url: String,
+    #[serde(default)]
+    icon: String,
+}
+
+#[derive(Debug, Serialize, Deserialize)]
+struct BackupLibraryManga {
+    #[serde(rename = "mangaId", default)]
+    manga_id: i64,
+    #[serde(rename = "sourceId", default)]
+    source_id: i64,
+    #[serde(default)]
+    title: String,
+    #[serde(default)]
+    path: String,
+    #[serde(rename = "coverUrl", default)]
+    cover_url: String,
+    #[serde(default)]
+    categories: Vec<String>,
+    #[serde(rename = "currentReading", default)]
+    current_reading: Option<BackupHistoryEntry>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+struct BackupHistoryEntry {
+    /// Server-local manga id. Present for diagnostics only: ids are not stable
+    /// between servers, restore resolves the manga by source + path instead.
+    #[serde(rename = "mangaId", default)]
+    manga_id: i64,
+    #[serde(rename = "sourceId", default)]
+    source_id: i64,
+    #[serde(rename = "mangaTitle", default)]
+    manga_title: String,
+    #[serde(rename = "mangaPath", default)]
+    manga_path: String,
+    #[serde(rename = "chapterId", default)]
+    chapter_id: i64,
+    #[serde(rename = "chapterTitle", default)]
+    chapter_title: String,
+    #[serde(rename = "chapterPath", default)]
+    chapter_path: String,
+    #[serde(rename = "chapterNumber", default)]
+    chapter_number: f64,
+    #[serde(rename = "readAt", default)]
+    read_at: String,
+    #[serde(rename = "lastPageRead", default)]
+    last_page_read: i64,
+    #[serde(rename = "isComplete", default)]
+    is_complete: bool,
+}
+
+#[derive(SimpleObject)]
+pub struct MissingBackupSource {
+    pub id: i64,
+    pub name: String,
+    pub version: String,
+}
+
+#[derive(SimpleObject)]
+pub struct RestoreBackupResult {
+    /// Library titles added by the restore.
+    pub imported: i32,
+    /// Read-history rows restored (including the currently-read chapter).
+    pub history_restored: i32,
+    /// Entries that could not be restored (already present, missing source or
+    /// an error); see `errors` for per-entry details.
+    pub skipped: i32,
+    /// Sources used by the backup that are not installed on this server.
+    pub missing_sources: Vec<MissingBackupSource>,
+    /// Human readable per-entry problems, capped at [`MAX_REPORTED_ERRORS`].
+    pub errors: Vec<String>,
+}
+
+const MAX_REPORTED_ERRORS: usize = 15;
+
+#[derive(Default)]
+pub struct BackupRoot;
+
+#[Object]
+impl BackupRoot {
+    /// Export the signed-in user's library, read history and the sources those
+    /// entries need as a JSON document.
+    async fn export_backup(&self, ctx: &Context<'_>) -> Result<String> {
+        let claims = ctx
+            .data::<Claims>()
+            .map_err(|_| "token not exists, please login")?;
+        let config = ctx.data::<Config>()?;
+        let source_svc = ctx.data::<SourceService<SourceRepositoryImpl>>()?;
+        let manga_svc = ctx.data::<MangaService<MangaRepositoryImpl>>()?;
+        let chapter_svc = ctx.data::<ChapterService<ChapterRepositoryImpl>>()?;
+        let library_svc = ctx.data::<LibraryService<LibraryRepositoryImpl>>()?;
+        let history_svc = ctx
+            .data::<HistoryService<ChapterRepositoryImpl, HistoryRepositoryImpl>>()?;
+
+        let installed_sources = source_svc
+            .get_installed_sources(&config.extension_repository, false)
+            .await?;
+        let source_map: HashMap<i64, BackupSource> = installed_sources
+            .iter()
+            .map(|source| {
+                (
+                    source.id,
+                    BackupSource {
+                        id: source.id,
+                        name: source.name.clone(),
+                        version: source.version.clone(),
+                        url: source.url.clone(),
+                        icon: source.icon.clone(),
+                    },
+                )
+            })
+            .collect();
+
+        // Category names per library manga, and the union of every category's
+        // manga plus the uncategorized ones (`None` only matches rows without a
+        // category, so each category is fetched explicitly).
+        let categories = library_svc.get_categories_by_user_id(claims.sub).await?;
+        let mut manga_categories: HashMap<i64, Vec<String>> = HashMap::new();
+        let mut library_manga: Vec<crate::domain::entities::manga::Manga> = Vec::new();
+        let mut library_ids: HashSet<i64> = HashSet::new();
+
+        for manga in library_svc
+            .get_manga_from_library_by_category_id(claims.sub, None)
+            .await?
+        {
+            if library_ids.insert(manga.id) {
+                library_manga.push(manga);
+            }
+        }
+        for category in &categories {
+            let Some(category_id) = category.id else { continue };
+            let manga = library_svc
+                .get_manga_from_library_by_category_id(claims.sub, Some(category_id))
+                .await?;
+            for manga in manga {
+                manga_categories
+                    .entry(manga.id)
+                    .or_default()
+                    .push(category.name.clone());
+                if library_ids.insert(manga.id) {
+                    library_manga.push(manga);
+                }
+            }
+        }
+        let history_chapters = history_svc
+            .get_history_chapters(claims.sub, HistoryBounds::default(), None, None)
+            .await?;
+
+        // manga_id -> (source_id, path, title), for library and history entries.
+        let mut manga_details: HashMap<i64, (i64, String, String)> = library_manga
+            .iter()
+            .map(|manga| {
+                (
+                    manga.id,
+                    (manga.source_id, manga.path.clone(), manga.title.clone()),
+                )
+            })
+            .collect();
+
+        let mut history_by_manga: HashMap<i64, Vec<&crate::domain::entities::history::HistoryChapter>> =
+            HashMap::new();
+        for chapter in &history_chapters {
+            history_by_manga
+                .entry(chapter.manga_id)
+                .or_default()
+                .push(chapter);
+        }
+
+        for manga_id in history_by_manga.keys() {
+            if manga_details.contains_key(manga_id) {
+                continue;
+            }
+            if let Ok(manga) = manga_svc.fetch_manga_by_id(*manga_id, false).await {
+                manga_details.insert(
+                    manga.id,
+                    (manga.source_id, manga.path.clone(), manga.title.clone()),
+                );
+            }
+        }
+
+        // Chapter metadata needed to match a chapter on another server.
+        let mut chapter_meta: HashMap<i64, (String, f64, String)> = HashMap::new();
+        for (manga_id, _) in &history_by_manga {
+            let Some((source_id, manga_path, _)) = manga_details.get(manga_id) else {
+                continue;
+            };
+            match chapter_svc
+                .fetch_chapters_by_manga_id(*source_id, manga_path, *manga_id, false)
+                .await
+            {
+                Ok(chapters) => {
+                    for chapter in chapters {
+                        chapter_meta
+                            .insert(chapter.id, (chapter.path, chapter.number, chapter.title));
+                    }
+                }
+                Err(error) => {
+                    warn!("backup: could not load chapters for manga {manga_id}: {error}");
+                }
+            }
+        }
+
+        let history: Vec<BackupHistoryEntry> = history_chapters
+            .iter()
+            .map(|chapter| {
+                let meta = chapter_meta.get(&chapter.chapter_id);
+                BackupHistoryEntry {
+                    manga_id: chapter.manga_id,
+                    source_id: chapter.source_id,
+                    manga_title: chapter.manga_title.clone(),
+                    manga_path: manga_details
+                        .get(&chapter.manga_id)
+                        .map(|details| details.1.clone())
+                        .unwrap_or_default(),
+                    chapter_id: chapter.chapter_id,
+                    chapter_title: chapter.chapter_title.clone(),
+                    chapter_path: meta.map(|meta| meta.0.clone()).unwrap_or_default(),
+                    chapter_number: meta.map(|meta| meta.1).unwrap_or_default(),
+                    read_at: chapter.read_at.format("%Y-%m-%dT%H:%M:%S%.f").to_string(),
+                    last_page_read: chapter.last_page_read,
+                    is_complete: chapter.is_complete,
+                }
+            })
+            .collect();
+
+        // History is sorted newest first, so the first entry per manga is the
+        // chapter the user is currently reading.
+        let mut current_reading: HashMap<i64, BackupHistoryEntry> = HashMap::new();
+        for entry in &history {
+            current_reading
+                .entry(entry.manga_id)
+                .or_insert_with(|| entry.clone());
+        }
+
+        let mut used_sources: BTreeSet<i64> = BTreeSet::new();
+        for manga in &library_manga {
+            used_sources.insert(manga.source_id);
+        }
+        for entry in &history {
+            used_sources.insert(entry.source_id);
+        }
+        let sources: Vec<BackupSource> = used_sources
+            .iter()
+            .filter_map(|source_id| source_map.get(source_id).cloned())
+            .collect();
+
+        let library: Vec<BackupLibraryManga> = library_manga
+            .iter()
+            .map(|manga| BackupLibraryManga {
+                manga_id: manga.id,
+                source_id: manga.source_id,
+                title: manga.title.clone(),
+                path: manga.path.clone(),
+                cover_url: manga.cover_url.clone(),
+                categories: manga_categories
+                    .get(&manga.id)
+                    .cloned()
+                    .unwrap_or_default(),
+                current_reading: current_reading.get(&manga.id).cloned(),
+            })
+            .collect();
+
+        let document = BackupDocument {
+            format: BACKUP_FORMAT.to_string(),
+            version: BACKUP_VERSION,
+            exported_at: Utc::now().format("%Y-%m-%dT%H:%M:%SZ").to_string(),
+            server_version: env!("CARGO_PKG_VERSION").to_string(),
+            sources,
+            library,
+            history,
+        };
+
+        serde_json::to_string_pretty(&document)
+            .map_err(|error| format!("could not serialize the backup: {error}").into())
+    }
+}
+
+#[derive(Default)]
+pub struct BackupMutationRoot;
+
+#[Object]
+impl BackupMutationRoot {
+    /// Restore a document produced by `exportBackup`.
+    ///
+    /// Manga are matched by source + source path, chapters by path (falling
+    /// back to number and title), so a backup can be restored on a different
+    /// server. Sources that are not installed are reported back instead of
+    /// failing the whole import.
+    async fn restore_backup(&self, ctx: &Context<'_>, data: String) -> Result<RestoreBackupResult> {
+        let claims = ctx
+            .data::<Claims>()
+            .map_err(|_| "token not exists, please login")?;
+        let config = ctx.data::<Config>()?;
+        let source_svc = ctx.data::<SourceService<SourceRepositoryImpl>>()?;
+        let manga_svc = ctx.data::<MangaService<MangaRepositoryImpl>>()?;
+        let chapter_svc = ctx.data::<ChapterService<ChapterRepositoryImpl>>()?;
+        let library_svc = ctx.data::<LibraryService<LibraryRepositoryImpl>>()?;
+        let history_svc = ctx
+            .data::<HistoryService<ChapterRepositoryImpl, HistoryRepositoryImpl>>()?;
+
+        let document: BackupDocument = serde_json::from_str(&data)
+            .map_err(|error| format!("This is not a valid Tanoshi backup file: {error}"))?;
+        if document.format != BACKUP_FORMAT {
+            return Err(format!(
+                "Unsupported backup format \"{}\": expected \"{BACKUP_FORMAT}\"",
+                document.format
+            )
+            .into());
+        }
+        if document.version != BACKUP_VERSION {
+            return Err(format!(
+                "Unsupported backup version {}: this app reads version {BACKUP_VERSION}",
+                document.version
+            )
+            .into());
+        }
+
+        let installed = source_svc
+            .get_installed_sources(&config.extension_repository, false)
+            .await?;
+        let installed_ids: HashSet<i64> = installed.iter().map(|source| source.id).collect();
+        let backup_sources: HashMap<i64, &BackupSource> = document
+            .sources
+            .iter()
+            .map(|source| (source.id, source))
+            .collect();
+
+        // Sources needed by the backup but missing on this server.
+        let mut missing: BTreeMap<i64, MissingBackupSource> = BTreeMap::new();
+        let note_missing = |source_id: i64,
+                                missing: &mut BTreeMap<i64, MissingBackupSource>| {
+            if installed_ids.contains(&source_id) || missing.contains_key(&source_id) {
+                return;
+            }
+            let source = backup_sources.get(&source_id);
+            missing.insert(
+                source_id,
+                MissingBackupSource {
+                    id: source_id,
+                    name: source
+                        .map(|source| source.name.clone())
+                        .filter(|name| !name.is_empty())
+                        .unwrap_or_else(|| format!("Source {source_id}")),
+                    version: source.map(|source| source.version.clone()).unwrap_or_default(),
+                },
+            );
+        };
+        for manga in &document.library {
+            note_missing(manga.source_id, &mut missing);
+        }
+        for entry in &document.history {
+            note_missing(entry.source_id, &mut missing);
+        }
+
+        let mut existing_library: HashSet<i64> = library_svc
+            .get_manga_from_library_by_category_id(claims.sub, None)
+            .await?
+            .into_iter()
+            .map(|manga| manga.id)
+            .collect();
+        let category_list = library_svc.get_categories_by_user_id(claims.sub).await?;
+        for category in &category_list {
+            let Some(category_id) = category.id else { continue };
+            for manga in library_svc
+                .get_manga_from_library_by_category_id(claims.sub, Some(category_id))
+                .await?
+            {
+                existing_library.insert(manga.id);
+            }
+        }
+        let mut category_ids: HashMap<String, i64> = category_list
+            .iter()
+            .filter_map(|category| category.id.map(|id| (category.name.clone(), id)))
+            .collect();
+
+        // (source_id, source path) -> resolved manga id, so repeated entries for
+        // the same title are only fetched once.
+        let mut resolved_manga: HashMap<(i64, String), Option<i64>> = HashMap::new();
+        let mut chapter_cache: HashMap<i64, Vec<crate::domain::entities::chapter::Chapter>> =
+            HashMap::new();
+
+        let mut imported = 0i32;
+        let mut history_restored = 0i32;
+        let mut skipped = 0i32;
+        let mut errors: Vec<String> = Vec::new();
+        let report_error = |errors: &mut Vec<String>, message: String| {
+            if errors.len() < MAX_REPORTED_ERRORS {
+                errors.push(message);
+            }
+        };
+        for manga in &document.library {
+            if !installed_ids.contains(&manga.source_id) {
+                skipped += 1;
+                continue;
+            }
+            let Some(manga_id) =
+                resolve_manga(&manga_svc, &mut resolved_manga, manga.source_id, &manga.path).await
+            else {
+                skipped += 1;
+                report_error(
+                    &mut errors,
+                    format!("{}: could not resolve the title on its source", manga.title),
+                );
+                continue;
+            };
+
+            if existing_library.contains(&manga_id) {
+                skipped += 1;
+                continue;
+            }
+
+            let mut category_targets: Vec<i64> = Vec::new();
+            for name in &manga.categories {
+                let name = name.trim();
+                if name.is_empty() || name.eq_ignore_ascii_case("default") {
+                    continue;
+                }
+                if let Some(category_id) = category_ids.get(name) {
+                    category_targets.push(*category_id);
+                    continue;
+                }
+                match library_svc.create_category(claims.sub, name).await {
+                    Ok(category) => {
+                        if let Some(category_id) = category.id {
+                            category_ids.insert(name.to_string(), category_id);
+                            category_targets.push(category_id);
+                        }
+                    }
+                    Err(error) => report_error(
+                        &mut errors,
+                        format!("{}: could not create category \"{name}\": {error}", manga.title),
+                    ),
+                }
+            }
+
+            match library_svc
+                .insert_manga_to_library(claims.sub, manga_id, category_targets)
+                .await
+            {
+                Ok(()) => imported += 1,
+                Err(error) => {
+                    skipped += 1;
+                    report_error(
+                        &mut errors,
+                        format!("{}: could not add it to the library: {error}", manga.title),
+                    );
+                }
+            }
+        }
+
+        for entry in &document.history {
+            if !installed_ids.contains(&entry.source_id) {
+                skipped += 1;
+                continue;
+            }
+            let Some(manga_id) =
+                resolve_manga(&manga_svc, &mut resolved_manga, entry.source_id, &entry.manga_path)
+                    .await
+            else {
+                skipped += 1;
+                report_error(
+                    &mut errors,
+                    format!("{}: could not resolve the title on its source", entry.manga_title),
+                );
+                continue;
+            };
+
+            if !chapter_cache.contains_key(&manga_id) {
+                let chapters = chapter_svc
+                    .fetch_chapters_by_manga_id(
+                        entry.source_id,
+                        &entry.manga_path,
+                        manga_id,
+                        false,
+                    )
+                    .await
+                    .unwrap_or_default();
+                chapter_cache.insert(manga_id, chapters);
+            }
+            let chapters = chapter_cache.get(&manga_id).cloned().unwrap_or_default();
+            let chapter = chapters
+                .iter()
+                .find(|chapter| {
+                    !entry.chapter_path.is_empty() && chapter.path == entry.chapter_path
+                })
+                .or_else(|| {
+                    chapters
+                        .iter()
+                        .find(|chapter| (chapter.number - entry.chapter_number).abs() < 1e-6)
+                })
+                .or_else(|| {
+                    chapters.iter().find(|chapter| {
+                        !entry.chapter_title.is_empty() && chapter.title == entry.chapter_title
+                    })
+                });
+
+            let Some(chapter) = chapter else {
+                skipped += 1;
+                report_error(
+                    &mut errors,
+                    format!(
+                        "{}: chapter \"{}\" no longer exists on the source",
+                        entry.manga_title, entry.chapter_title
+                    ),
+                );
+                continue;
+            };
+
+            match history_svc
+                .import_history_chapter(
+                    claims.sub,
+                    chapter.id,
+                    entry.last_page_read,
+                    entry.is_complete,
+                    parse_read_at(&entry.read_at),
+                )
+                .await
+            {
+                Ok(()) => history_restored += 1,
+                Err(error) => {
+                    skipped += 1;
+                    report_error(
+                        &mut errors,
+                        format!(
+                            "{}: could not restore chapter \"{}\": {error}",
+                            entry.manga_title, entry.chapter_title
+                        ),
+                    );
+                }
+            }
+        }
+
+        Ok(RestoreBackupResult {
+            imported,
+            history_restored,
+            skipped,
+            missing_sources: missing.into_values().collect(),
+            errors,
+        })
+    }
+}
+
+async fn resolve_manga(
+    manga_svc: &MangaService<MangaRepositoryImpl>,
+    cache: &mut HashMap<(i64, String), Option<i64>>,
+    source_id: i64,
+    path: &str,
+) -> Option<i64> {
+    if path.trim().is_empty() {
+        return None;
+    }
+    let key = (source_id, path.to_string());
+    if let Some(cached) = cache.get(&key) {
+        return *cached;
+    }
+    let manga = manga_svc
+        .fetch_manga_by_source_path(source_id, path)
+        .await
+        .ok()
+        .map(|manga| manga.id);
+    cache.insert(key, manga);
+    manga
+}
+
+fn parse_read_at(value: &str) -> NaiveDateTime {
+    NaiveDateTime::parse_from_str(value, "%Y-%m-%dT%H:%M:%S%.f")
+        .or_else(|_| {
+            chrono::DateTime::parse_from_rfc3339(value).map(|date| date.naive_utc())
+        })
+        .unwrap_or_else(|_| Utc::now().naive_utc())
+}
+
