+    fn paged_image(this: Rc<Self>, index: usize, page: String, double: bool) -> Dom {
+        let source_id = this.source_id.get();
+        html!("img" => HtmlImageElement, {
+            .attr("id", format!("{index}").as_str())
+            .attr("src", &proxied_image_url(&page, source_id))
+            .style("margin-left", "auto")
+            .style("margin-right", "auto")
+            .style_signal("object-fit", this.reader_settings.fit.signal().map(|_| "contain"))
+            .style_signal("max-width", this.reader_settings.fit.signal().map(|fit| match fit {
+                crate::common::Fit::Height => "none",
+                _ => "100%",
+            }))
+            .style_signal("width", this.reader_settings.fit.signal().map(move |fit| match fit {
+                crate::common::Fit::Height => "initial",
+                _ if double => "50%",
+                _ => "100vw",
+            }))
+            .style_signal("height", this.reader_settings.fit.signal().map(move |fit| match fit {
+                crate::common::Fit::Width => if double { "100%" } else { "initial" },
+                _ if double => "100%",
+                _ => "100vh",
+            }))
+            .event(clone!(this, page => move |_: events::Error| {
+                log::error!("error loading image for page {}", index);
+                this.pages.lock_mut().set_cloned(index, (page.clone(), PageStatus::Error));
+                this.set_page_dimensions(index, None);
+            }))
+            .with_node!(img => {
+                .event(clone!(this, page, img => move |_: events::Load| {
+                    this.record_page_dimensions(index, &img);
+                    Self::detect_webtoon(this.clone());
+                    if !matches!(this.pages.lock_ref().get(index).map(|(_, status)| status), Some(PageStatus::Loaded)) {
+                        this.pages.lock_mut().set_cloned(index, (page.clone(), PageStatus::Loaded));
+                    }
+                }))
+            })
+            .event(clone!(this => move |_: events::Click| {
+                this.is_bar_visible.set_neq(!this.is_bar_visible.get());
+            }))
+        })
+    }
