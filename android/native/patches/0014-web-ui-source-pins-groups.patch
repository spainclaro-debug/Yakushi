+            .flatten()
+            .and_then(|raw| serde_json::from_str::<Vec<i64>>(&raw).ok())
+            .unwrap_or_default();
+        if !pinned.is_empty() {
+            catalogue.pinned.lock_mut().replace_cloned(pinned);
+        }
+
         Rc::new(catalogue)
     }
 
+    fn toggle_pin(catalogue: Rc<Self>, source_id: i64) {
+        let mut pinned: Vec<i64> = catalogue.pinned.lock_ref().iter().copied().collect();
+        if let Some(position) = pinned.iter().position(|id| *id == source_id) {
+            pinned.remove(position);
+        } else {
+            pinned.push(source_id);
+        }
+        catalogue.pinned.lock_mut().replace_cloned(pinned.clone());
+        if let Ok(raw) = serde_json::to_string(&pinned) {
+            let _ = local_storage().set_item(PINNED_KEY, &raw);
+        }
+    }
+
     pub fn serialize_into_json(&self) -> String {
