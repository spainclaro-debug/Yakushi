+    /// them complete. This marks every chapter whose last page was crossed
+    /// between the previous and the current page.
+    fn mark_crossed_chapters(this: Rc<Self>, page: usize) {
+        let Some(previous) = this.last_page_seen.replace(Some(page)) else {
+            return;
+        };
