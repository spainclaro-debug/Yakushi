+    /// Builds the save-image menu entry from a DOM image target. Uses the
+    /// image's current (already proxied) absolute URL so the Android bridge or
+    /// the browser can download exactly the bytes being displayed.
+    fn visible_page_image() -> Option<HtmlImageElement> {
+        let page_list = document().get_element_by_id("page-list")?;
+        let children = page_list.children();
+        for index in 0..children.length() {
+            let Some(node) = children.item(index) else {
+                continue;
+            };
+            let Ok(image) = node.dyn_into::<HtmlImageElement>() else {
+                continue;
+            };
+            if image.offset_width() > 0 && image.offset_height() > 0 {
+                return Some(image);
+            }
+        }
+        None
+    }
+
+    fn image_menu_for(this: &Rc<Self>, target: Option<web_sys::EventTarget>) -> Option<ImageMenu> {
+        // Paged mode renders navigation/tap overlays above the page images, so
+        // the event target is usually the overlay rather than the <img>. Fall
+        // back to the currently visible paged image so long-press/right-click
+        // works in both continuous and paged reading modes.
+        let image = match target.and_then(|target| target.dyn_into::<HtmlImageElement>().ok()) {
+            Some(image) => image,
+            None if matches!(this.reader_settings.reader_mode.get(), ReaderMode::Paged) => {
+                Self::visible_page_image()?
+            }
+            None => return None,
+        };
+        let url = image.current_src();
+        if url.is_empty() {
+            return None;
+        }
+        let file_name = format!(
+            "yakushi-chapter-{}-{}.jpg",
+            this.chapter_id.get(),
+            js_sys::Date::now() as i64
+        );
+        Some(ImageMenu { url, file_name })
+    }
+
+    fn show_image_menu(this: Rc<Self>, target: Option<web_sys::EventTarget>) {
+        if let Some(menu) = Self::image_menu_for(&this, target) {
+            this.image_menu.set(Some(menu));
+        }
+    }
+
+    fn start_long_press(this: Rc<Self>, target: Option<web_sys::EventTarget>) {
+        Self::cancel_long_press(&this);
+        if let Some(menu) = Self::image_menu_for(&this, target) {
+            let timeout = Timeout::new(550, clone!(this, menu => move || {
+                this.image_menu.set(Some(menu.clone()));
+            }));
+            this.long_press.borrow_mut().replace(timeout);
+        }
+    }
+
+    fn cancel_long_press(this: &Rc<Self>) {
+        // Dropping the Timeout cancels it.
+        this.long_press.borrow_mut().take();
+    }
+
+    fn save_image(menu: &ImageMenu) {
+        // In the Android app `TanoshiApp.saveImage` writes the bytes to the
+        // phone's Downloads folder through MediaStore. In a normal browser the
+        // same script falls back to a download link.
+        let js = format!(
+            r#"(function(){{try{{var url={url};var name={name};var app=window.TanoshiApp;if(app&&typeof app.saveImage==='function'){{try{{var r=app.saveImage(url,name);if(r&&String(r).indexOf('OK|')===0)return r;}}catch(e){{}}}}var a=document.createElement('a');a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();return 'OK|Downloads/'+name;}}catch(e){{return 'ERROR|'+(e&&e.message?e.message:String(e));}}}})()"#,
+            url = serde_json::to_string(&menu.url).unwrap_or_default(),
+            name = serde_json::to_string(&menu.file_name)
+                .unwrap_or_else(|_| "\"image.jpg\"".to_string()),
+        );
+        match js_sys::eval(&js) {
+            Ok(value) => {
+                let result = value.as_string().unwrap_or_default();
+                if let Some(location) = result.strip_prefix("OK|") {
+                    snackbar::show(format!("Image saved to {location}"));
+                } else if let Some(message) = result.strip_prefix("ERROR|") {
+                    snackbar::show(format!("Could not save image: {message}"));
+                } else {
+                    snackbar::show("Downloading image…".to_string());
+                }
+            }
+            Err(_) => snackbar::show("Could not save the image".to_string()),
+        }
+    }
