+                                e.stop_propagation();
+                            })
+                            .children(&mut [
+                                html!("p", {
+                                    .text("Save this image to your Downloads folder?")
+                                }),
+                                html!("div", {
+                                    .class("image-save-actions")
+                                    .children(&mut [
+                                        html!("button", {
+                                            .class("action-button")
+                                            .text("Save image")
+                                            .event(clone!(save_this, menu_for_save => move |_: events::Click| {
+                                                Self::save_image(&menu_for_save);
+                                                save_this.image_menu.set(None);
+                                            }))
+                                        }),
+                                        html!("button", {
+                                            .class("action-button")
+                                            .text("Cancel")
+                                            .event(clone!(this => move |_: events::Click| {
+                                                this.image_menu.set(None);
+                                            }))
+                                        }),
+                                    ])
+                                }),
+                            ])
+                        }),
+                    ])
+                })
+            }))))
+        })
+    }
