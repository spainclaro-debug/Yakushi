+    /// Loads the shared preset list from the server. When the server has no
+    /// presets yet, the presets this device already had are uploaded once so
+    /// existing users keep them.
+    fn fetch_server_presets(this: Rc<Self>) {
+        spawn_local(async move {
+            let client = reqwest::Client::new();
+            let Ok(response) = client.get(Self::api_url()).send().await else {
+                return;
+            };
+            if !response.status().is_success() {
+                return;
+            }
+            let Ok(file) = response.json::<LayoutPresetsFile>().await else {
+                return;
+            };
+
+            let server_presets: Vec<LayoutPreset> = file
+                .presets
+                .into_iter()
+                .filter(|preset| preset.name != DEFAULT_PRESET_NAME)
+                .collect();
+            let local_presets: Vec<LayoutPreset> = this
+                .presets
+                .lock_ref()
+                .iter()
+                .filter(|preset| preset.name != DEFAULT_PRESET_NAME)
+                .cloned()
+                .collect();
+
+            if server_presets.is_empty() && !local_presets.is_empty() {
+                Self::persist_server(&local_presets);
+                return;
+            }
+
+            {
+                let mut presets = this.presets.lock_mut();
+                presets.clear();
+                presets.push_cloned(LayoutPreset::default_preset());
+                for preset in server_presets {
+                    presets.push_cloned(preset);
+                }
+            }
+            Self::persist_presets(&this.presets.lock_ref());
+
+            let selected = this.selected.get_cloned();
+            if !this
+                .presets
+                .lock_ref()
+                .iter()
+                .any(|preset| preset.name == selected)
+            {
+                this.selected.set(DEFAULT_PRESET_NAME.to_string());
+                let _ = local_storage().set_item(SELECTED_KEY, DEFAULT_PRESET_NAME);
+            }
+        });
+    }
