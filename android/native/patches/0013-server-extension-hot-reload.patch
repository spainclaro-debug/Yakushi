+    /// Reload every plugin from disk without deleting anything: drain the
+    /// current registrations, stop their workers, then run `load_all` so added,
+    /// removed and disabled extensions are reflected without a server restart.
+    pub async fn reload_all(&self) -> Result<()> {
+        // Reload only plugin-managed entries: in-process sources such as the
+        // built-in Local folder libraries have no plugin_path and must stay.
+        let entries: Vec<Arc<SourceEntry>> = {
+            let mut sources = self.write()?;
+            let plugin_ids: Vec<i64> = sources
+                .iter()
+                .filter(|(_, entry)| entry.plugin_path().is_some())
+                .map(|(source_id, _)| *source_id)
+                .collect();
+            plugin_ids
+                .into_iter()
+                .filter_map(|source_id| sources.remove(&source_id))
+                .collect()
+        };
+        for entry in entries {
+            entry.queue.close();
+            if let Some(worker) = entry.worker() {
+                worker.shutdown().await;
+            }
+        }
+        self.load_all().await
+    }
+
     pub async fn exists(&self, source_id: i64) -> Result<bool> {
