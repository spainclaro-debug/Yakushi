+
+    fn download_chapter(manga: Rc<Self>, chapter_id: i64) {
+        manga.selected_chapters.lock_mut().insert(chapter_id, ());
+        Self::download_chapters(manga);
+    }
+
+    /// True when the event came from the per-chapter download button so the
+    /// row's tap/long-press navigation handlers can ignore it.
+    fn is_row_action(target: Option<web_sys::EventTarget>) -> bool {
+        target
+            .and_then(|target| target.dyn_into::<web_sys::Element>().ok())
+            .map(|element| element.tag_name().eq_ignore_ascii_case("BUTTON"))
+            .unwrap_or(false)
+    }
+
+    /// Refresh the chapter list while a download is queued so downloaded icons
+    /// and progress appear without a manual reload; stops once no chapter has a
+    /// pending download status.
+    fn schedule_download_refresh(manga: Rc<Self>, remaining: u32) {
+        if remaining == 0 {
+            return;
+        }
+        Timeout::new(4_000, clone!(manga => move || {
+            if manga.id.get() != 0 {
+                Self::fetch_detail(manga.clone(), false);
+            } else if manga.source_id.get() != 0 && manga.path.get_cloned() != "" {
+                Self::fetch_detail_by_source_path(manga.clone());
+            }
+
+            let pending = manga
+                .chapters
+                .lock_ref()
+                .iter()
+                .any(|chapter| chapter.download_status.is_some());
+            if pending {
+                Self::schedule_download_refresh(manga.clone(), remaining.saturating_sub(1));
+            }
+        }))
+        .forget();
+    }
     
