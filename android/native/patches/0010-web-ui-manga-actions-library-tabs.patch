+    fn fetch_migrate_sources(manga: Rc<Self>) {
+        manga.loader.load(clone!(manga => async move {
+            match query::fetch_sources().await {
+                Ok(sources) => {
+                    manga.migrate_sources.lock_mut().replace_cloned(
+                        sources
+                            .iter()
+                            .map(|source| MigrateSource {
+                                id: source.id,
+                                name: source.name.clone(),
+                            })
+                            .collect(),
+                    );
+                }
+                Err(error) => snackbar::show(format!("Could not load sources: {error}")),
+            }
+        }));
+    }
+
+    fn start_migration(manga: Rc<Self>, to_source_id: i64) {
+        if manga.id.get() == 0 {
+            snackbar::show("Open the saved manga before migrating".to_string());
+            return;
+        }
+        let title = manga.title.get_cloned().unwrap_or_default();
+        migration::set(&migration::MigrationState {
+            from_manga_id: manga.id.get(),
+            from_source_id: manga.source_id.get(),
+            from_title: title.clone(),
+            to_source_id,
+        });
+        manga.migrate_open.set(false);
+        routing::go_to_url(
+            &Route::Catalogue {
+                id: to_source_id,
+                latest: false,
+                query: Some(title),
+            }
+            .url(),
+        );
+    }
+
+    fn change_library(manga: Rc<Self>, category_ids: Vec<i64>) {
+        if manga.id.get() == 0 {
+            return;
+        }
+        manga.loader.load(clone!(manga => async move {
+            match query::delete_from_library(manga.id.get()).await {
+                Ok(_) => match query::add_to_library(manga.id.get(), category_ids).await {
+                    Ok(_) => {
+                        manga.is_favorite.set_neq(true);
+                        snackbar::show("Library updated".to_string());
+                    }
+                    Err(error) => snackbar::show(format!("Could not change library: {error}")),
+                },
+                Err(error) => snackbar::show(format!("Could not change library: {error}")),
+            }
+        }));
+    }
