+
+/* --- Per-device theme palette (Settings -> Appearance -> Themes) ----------
+   The chosen palette sets these variables inline on :root/documentElement and
+   is stored in localStorage, so it is local to the device/browser. */
+:root {
+    --secondary-color: #{$color-gray-300};
+    --accent-color: #{$primary-color-600};
+}
+
+body.dark {
+    --secondary-color: #{$color-gray-700};
+    --accent-color: #{$primary-color-300};
+}
+
+.theme-preset-list {
+    display: flex;
+    flex-direction: column;
+    gap: 0.25rem;
+    margin: 0.5rem;
+}
+
+.theme-preset-row {
+    display: flex;
+    align-items: center;
+    gap: 0.4rem;
+    padding: 0.5rem;
+    border: 2px solid transparent;
+    border-radius: 0.5rem;
+    cursor: pointer;
+
+    &.active {
+        border-color: var(--accent-color);
+        background-color: color-mix(in srgb, var(--secondary-color) 18%, transparent);
+    }
+}
+
+.theme-preset-name {
+    margin-left: 0.25rem;
+}
+
+.theme-swatch {
+    display: inline-block;
+    width: 1.1rem;
+    height: 1.1rem;
+    border: 1px solid rgba(0, 0, 0, 0.15);
+    border-radius: 50%;
+}
+
+.theme-colors {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 0.4rem;
+    margin: 0.25rem 0.5rem 0.75rem 0.5rem;
+}
+
+.theme-color-swatch {
+    width: 2rem;
+    height: 2rem;
+    min-width: 0;
+    padding: 0;
+    border: 2px solid transparent;
+    border-radius: 0.4rem;
+    cursor: pointer;
+
+    &.active {
+        border-color: var(--accent-color);
+    }
+}
+
+.theme-new-btn {
+    margin: 0.5rem;
+}
+
+.theme-actions {
+    display: flex;
+    gap: 0.5rem;
+    margin: 0.5rem;
+}
+
+.list-item:hover {
+    background-color: color-mix(in srgb, var(--secondary-color) 18%, transparent);
+}
