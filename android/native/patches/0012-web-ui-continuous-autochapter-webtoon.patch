+    fn maybe_append_next_chapter(this: Rc<Self>) {
+        if !matches!(this.reader_settings.reader_mode.get(), ReaderMode::Continous) {
+            return;
+        }
+        if *this.appending.borrow() || this.at_end.get() {
+            return;
