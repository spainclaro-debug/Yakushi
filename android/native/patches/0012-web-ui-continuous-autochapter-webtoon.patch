+        *this.appending.borrow_mut() = true;
+        spawn_local(clone!(this => async move {
+            match query::fetch_chapter(next_chapter).await {
+                Ok(result) => {
+                    let page_count = result.pages.len();
+                    {
+                        let mut pages = this.pages.lock_mut();
+                        for page in result.pages {
+                            pages.push_cloned((page.to_string(), PageStatus::Initial));
+                        }
+                    }
+                    {
+                        let mut mapping = this.page_chapters.borrow_mut();
+                        for index in 0..page_count {
+                            mapping.push((next_chapter, index, page_count));
+                        }
+                    }
+                    this.page_dimensions
+                        .borrow_mut()
+                        .extend(vec![None; page_count]);
+                    this.next_chapter.set_neq(result.next);
+                    if result.next.is_none() {
+                        this.at_end.set_neq(true);
+                    }
+                    *this.appending.borrow_mut() = false;
+                    Self::schedule_continuous_page_update(this.clone());
+                }
+                Err(error) => {
+                    *this.appending.borrow_mut() = false;
+                    snackbar::show(format!("Could not load the next chapter: {error}"));
+                }
+            }
+        }));
+    }
+
+    /// A manhua/manhwa page is much taller than it is wide. When the first
+    /// loaded page looks like that, switch to the webtoon reading layout
+    /// (continuous, fit width) and keep only the fit controls in the settings.
+    fn detect_webtoon(this: Rc<Self>) {
+        if *this.webtoon_checked.borrow() {
+            return;
+        }
+        let (loaded_count, tall) = {
+            let dimensions = this.page_dimensions.borrow();
+            let loaded: Vec<_> = dimensions.iter().flatten().collect();
+            (
+                loaded.len(),
+                loaded
+                    .iter()
+                    .any(|dim| dim.width > 0 && dim.height as f64 >= dim.width as f64 * 2.5),
+            )
+        };
+        if !tall {
+            if loaded_count >= 3 {
+                *this.webtoon_checked.borrow_mut() = true;
+            }
+            return;
+        }
+        *this.webtoon_checked.borrow_mut() = true;
+        this.webtoon_mode.set(true);
+        this.reader_settings.reader_mode.set_neq(ReaderMode::Continous);
+        this.reader_settings.fit.set_neq(Fit::Width);
+        this.reader_settings.padding.set_neq(false);
+        this.reader_settings.save();
+        snackbar::show("Webtoon layout detected".to_string());
+    }
 
