+
+/// Allows any authenticated user (not just admins). Chapter downloads are
+/// shared by the instance, but self-service registered users should be able to
+/// use the reader's download button instead of getting "Forbidden".
+#[derive(Debug, Default)]
+pub struct AuthGuard;
+
+impl AuthGuard {
+    pub fn new() -> Self {
+        Self {}
+    }
+}
+
+impl Guard for AuthGuard {
+    async fn check(&self, ctx: &Context<'_>) -> Result<()> {
+        ctx.data::<Claims>()
+            .map_err(|_| "token not exists, please login")?;
+
+        Ok(())
+    }
+}
